#: includes/class-dahu-order-notes-settings.php:255
msgid "Additional automatic notes"
msgstr "Notes automatiques supplémentaires"

#: dahu-order-notes.php:142
msgid "By Hugo Vial-Jaime — Dahu-Concept"
msgstr "Par Hugo Vial-Jaime — Dahu-Concept"

#: includes/class-dahu-order-notes-settings.php:242
msgid "Customer note header colour"
msgstr "Couleur de l’en-tête des notes client"

#: includes/class-dahu-order-notes-settings.php:206
msgid "Dahu Order Notes highlights the order notes a person actually typed, so they stand out from the ones WooCommerce and its extensions generate on their own."
msgstr "Dahu Order Notes met en évidence les notes de commande qu’une personne a réellement écrites, pour qu’elles se distinguent de celles que WooCommerce et ses extensions ajoutent d’elles-mêmes."

#: dahu-order-notes.php:99
msgid "Dahu Order Notes requires WooCommerce to be installed and active."
msgstr "Dahu Order Notes nécessite que WooCommerce soit installé et actif."

#: includes/class-dahu-order-notes-settings.php:229
msgid "Hand-written note colour"
msgstr "Couleur des notes écrites à la main"

#: includes/class-dahu-order-notes-settings.php:222
msgid "Highlight hand-written private notes"
msgstr "Mettre en évidence les notes privées écrites à la main"

#: includes/class-dahu-order-notes-settings.php:215
msgid "Highlighting"
msgstr "Mise en évidence"

#: includes/class-dahu-order-notes-settings.php:264
msgid "One per line. Any note starting with one of these phrases is treated as automatic. Use this for notes added by other plugins — shipping, invoicing, payment gateways. Plain text, not regular expressions."
msgstr "Une par ligne. Toute note commençant par l’une de ces phrases est considérée comme automatique. À utiliser pour les notes posées par d’autres extensions : expédition, facturation, passerelles de paiement. Du texte simple, pas des expressions régulières."

